# Public values only. Copy to .env.local; never put service-role or AI keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# From eas init; also set this GitHub repository variable and Cloudflare variable.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Real backend by default. Set 1 explicitly only for the demonstration.
EXPO_PUBLIC_PREVIEW=0
# Guided add defaults on; set 0 to roll back when targeting a backend without U1/U2a/U3.
EXPO_PUBLIC_GUIDED_ADD=1
