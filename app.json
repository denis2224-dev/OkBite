{
  "expo": {
    "name": "okBite",
    "slug": "okbite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/toast-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A3E594",
        "foregroundImage": "./assets/icons/toast-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/toast-favicon.png"
    },
    "scheme": "okbite",
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite", "expo-font"]
  }
}
