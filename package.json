{
  "name": "okbite",
  "version": "1.0.0",
  "main": "src/main.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "@testing-library/react-native": "^14.1.0",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "idb-keyval": "^6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "tsx": "^4.23.15",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "dev": "expo start",
    "test": "pnpm test:sync-shared && pnpm test:app && pnpm test:web && pnpm -r test && pnpm test:scripts && pnpm test:local-gateway",
    "lint": "eslint .",
    "typecheck": "pnpm typecheck:app && pnpm -r typecheck",
    "e2e": "echo \"set up in D6\" && exit 1",
    "sync-shared": "node scripts/sync-shared.mjs",
    "format": "prettier --write .",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "awake": "sh scripts/keep-awake.sh",
    "dev:awake": "sh scripts/keep-awake.sh expo start",
    "web:awake": "sh scripts/keep-awake.sh expo start --web",
    "test:web": "jest --config jest.web.config.cjs --runInBand",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm data:check",
    "dev:scaffold": "npm --prefix apps/mobile start",
    "test:shared": "npm --prefix packages/shared test",
    "typecheck:shared": "npm --prefix packages/shared run typecheck",
    "test:scaffold": "npm --prefix apps/mobile test",
    "typecheck:scaffold": "npm --prefix apps/mobile run typecheck",
    "test:scripts": "vitest run --config vitest.scripts.config.mts",
    "data:check": "node --import tsx scripts/check-data.ts",
    "test:sync-shared": "node --test scripts/sync-shared.test.mjs",
    "test:local-gateway": "node --test supabase/tests/local-cors.test.mjs",
    "test:app": "jest --runInBand",
    "typecheck:app": "tsc --noEmit",
    "data:load": "tsx scripts/load-data.ts",
    "data:off": "tsx scripts/import-off.ts"
  },
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  }
}
