{
  "name": "okbite",
  "version": "1.0.0",
  "main": "src/main.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@testing-library/react-native": "^14.1.0",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "idb-keyval": "^6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fake-indexeddb": "^6.2.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.0",
    "workbox-cli": "7.4.1"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "test": "pnpm test:metro && pnpm test:toolchain && pnpm test:sync-shared && pnpm test:app && pnpm test:web && pnpm -r test && pnpm test:scripts && pnpm test:local-gateway && pnpm test:local-ops && pnpm test:media && pnpm test:web-env",
    "lint": "eslint .",
    "typecheck": "pnpm typecheck:app && pnpm -r typecheck && pnpm typecheck:e2e",
    "e2e": "maestro test .maestro/known-by-code.yaml",
    "sync-shared": "node scripts/sync-shared.mjs",
    "format": "prettier --write .",
    "start": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "web": "pnpm --filter mobile start --web",
    "build:web": "pnpm --filter mobile web",
    "awake": "sh scripts/keep-awake.sh",
    "dev:awake": "sh scripts/keep-awake.sh pnpm dev",
    "web:awake": "sh scripts/keep-awake.sh pnpm web",
    "test:web": "jest --config jest.web.config.cjs --runInBand",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm data:check",
    "dev:scaffold": "pnpm --filter mobile start",
    "test:shared": "pnpm --filter @okbite/shared test",
    "typecheck:shared": "pnpm --filter @okbite/shared typecheck",
    "test:scaffold": "pnpm --filter mobile test",
    "typecheck:scaffold": "pnpm --filter mobile typecheck",
    "test:scripts": "vitest run --config vitest.scripts.config.mts",
    "data:check": "node --import tsx scripts/check-data.ts",
    "test:sync-shared": "node --test scripts/sync-shared.test.mjs",
    "test:local-gateway": "node --test supabase/tests/local-cors.test.mjs",
    "test:app": "jest --runInBand",
    "typecheck:app": "tsc --noEmit",
    "data:load": "tsx scripts/load-data.ts",
    "data:off": "tsx scripts/import-off.ts",
    "label:accuracy": "tsx scripts/label-accuracy.ts",
    "preinstall": "node scripts/verify-toolchain.mjs",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "test:toolchain": "node --test scripts/verify-toolchain.test.mjs",
    "test:local-ops": "node --test supabase/tests/local-project.test.mjs",
    "pnpm:devPreinstall": "node scripts/verify-toolchain.mjs",
    "test:metro": "node --test scripts/metro-target.test.mjs",
    "e2e:offline": "maestro test .maestro/offline-history.yaml",
    "test:media": "node --test scripts/push-test-media.test.mjs",
    "test:web-env": "node --test scripts/check-web-env.test.mjs",
    "e2e:web": "playwright test -c e2e-web",
    "e2e:web:build": "EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:18766 EXPO_PUBLIC_SUPABASE_ANON_KEY=demo-only pnpm --filter mobile exec expo export -p web --output-dir dist-e2e && pnpm --filter mobile exec node scripts/copy-barcode-wasm.cjs dist-e2e && OKBITE_WEB_OUTPUT=dist-e2e pnpm --filter mobile exec workbox generateSW workbox-config.cjs",
    "typecheck:e2e": "tsc --noEmit -p e2e-web/tsconfig.json"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
